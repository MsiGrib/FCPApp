<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FCPApp.ViewModels"
        xmlns:models="using:FCPApp.Models"
        xmlns:converters="using:FCPApp.Converters"
        xmlns:views="using:FCPApp.Views"
        x:Class="FCPApp.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainViewModel"
        Title="FCPApp" Width="1200" Height="700" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a1a">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <converters:NotEmptyConverter x:Key="NotEmptyConverter"/>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <converters:SimpleBoolConverter x:Key="SimpleBoolConverter"/>
    </Window.Resources>

    <Window.Styles>

        <Style Selector="TreeViewItem" x:DataType="models:FolderTreeNode">
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="IsVisible" Value="{Binding IsVisible}"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>

        <Style Selector="TreeView#SelectedFoldersTree TreeViewItem" x:DataType="models:FolderTreeNode">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsVisible" Value="{Binding IsVisible}"/>
        </Style>

        <Style Selector="Button.nav-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#ccc"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.nav-btn:pointerover">
            <Setter Property="Background" Value="#333"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.nav-btn[Tag=Active]">
            <Setter Property="Background" Value="#3498db"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.action-btn">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style Selector="Button.action-btn:disabled">
            <Setter Property="Opacity" Value="0.5"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" Background="#1e1e1e" BorderBrush="#333" BorderThickness="0,0,0,1">
            <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="🏠 Home"
                            Classes="nav-btn"
                            Command="{Binding NavigateToHomeCommand}">
                        <Button.Tag>
                            <Binding Path="CurrentPage" Converter="{StaticResource StringEqualsConverter}" ConverterParameter="Home"/>
                        </Button.Tag>
                    </Button>

                    <Button Content="⚙️ Settings"
                            Classes="nav-btn"
                            Command="{Binding NavigateToSettingsCommand}">
                        <Button.Tag>
                            <Binding Path="CurrentPage" Converter="{StaticResource StringEqualsConverter}" ConverterParameter="Settings"/>
                        </Button.Tag>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#888" FontSize="12"
                           TextWrapping="Wrap" MaxWidth="600"/>

                <ProgressBar Grid.Column="2"
                             IsVisible="{Binding IsProcessing}"
                             IsIndeterminate="True"
                             Width="100" Height="4"
                             VerticalAlignment="Center"
                             Background="Transparent" Foreground="#3498db"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">

            <views:HomeView
            DataContext="{Binding HomeVm}"
            IsVisible="{Binding #RootWindow.DataContext.CurrentPage,
            Converter={StaticResource StringEqualsConverter},
            ConverterParameter=Home}"/>

            <views:SettingsView
            DataContext="{Binding SettingsVm}"
            IsVisible="{Binding #RootWindow.DataContext.CurrentPage,
            Converter={StaticResource StringEqualsConverter},
            ConverterParameter=Settings}"/>

        </Grid>

    </Grid>
</Window>