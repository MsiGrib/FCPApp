<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FCPApp.ViewModels"
             xmlns:models="using:FCPApp.Models"
             xmlns:converters="using:FCPApp.Converters"
             x:Class="FCPApp.Views.HomeView"
             x:DataType="vm:MainViewModel">


    <Grid Margin="15" ColumnDefinitions="*,300" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10">
            <TextBlock Text="📁 Root:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White"/>
            <TextBox Text="{Binding RootPath}" IsReadOnly="True" Width="400"
                     Watermark="The path is not chosen..." Margin="5,0"
                     Background="#2d2d2d" Foreground="White" BorderBrush="#444"/>
            <Button Content="Choose..." Click="OnSelectFolderClicked"
                    Classes="action-btn" Background="#3498db" Padding="12,6"/>
        </StackPanel>

        <Grid Grid.Row="1" Grid.Column="0" Margin="0,10,0,0"
              ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="5">

            <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="5,0" Foreground="White"/>
            <TextBox Grid.Column="1" Text="{Binding FolderFilter, UpdateSourceTrigger=PropertyChanged}"
                     Watermark="Filter by folder name..." Margin="0,0,5,0"
                     Background="#2d2d2d" Foreground="White" BorderBrush="#444"/>

            <Button Grid.Column="2" Content="🔎" Command="{Binding ApplyFilterCommand}"
                    Classes="action-btn" Background="#3498db"
                    ToolTip.Tip="Apply filter"/>
            <Button Grid.Column="3" Content="➕" Command="{Binding ExpandAllCommand}"
                    Classes="action-btn" Background="#27ae60"
                    ToolTip.Tip="Expand all"/>
            <Button Grid.Column="4" Content="➖" Command="{Binding CollapseAllCommand}"
                    Classes="action-btn" Background="#f39c12"
                    ToolTip.Tip="Collapse all"/>
            <Button Grid.Column="5" Content="🧹" Command="{Binding ClearSelectionCommand}"
                    Classes="action-btn" Background="#9b59b6"
                    ToolTip.Tip="Uncheck all boxes"/>
            <Button Grid.Column="6" Content="💾" Command="{Binding SaveConfigCommand}"
                    Classes="action-btn" Background="#27ae60"
                    ToolTip.Tip="Save configuration"/>
            <Button Grid.Column="7" Content="⏭" Command="{Binding ToggleSkipErrorsCommand}"
                    Classes="action-btn" Background="#95a5a6"
                    ToolTip.Tip="Skip errors"/>
            <Button Grid.Column="8" Content="🗑 Delete" Command="{Binding DeleteSelectedCommand}"
                    Classes="action-btn" Background="#c0392b"
                    IsEnabled="{Binding !IsProcessing}"
                    ToolTip.Tip="Delete selected folders"/>
        </Grid>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" FontSize="12" Foreground="Gray"
                   Text="💡 Tip: Select folders. The parent selects all descendants."/>

        <Border Grid.Row="3" Grid.Column="0" Margin="0,10,0,0"
                BorderBrush="#444" BorderThickness="1" CornerRadius="4" Background="#2d2d2d">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          IsTabStop="False">
                <TreeView ItemsSource="{Binding FolderTree}" Margin="5" MinHeight="200">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="2,4">
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </ScrollViewer>
        </Border>

        <ProgressBar Grid.Row="4" Grid.Column="0" IsVisible="{Binding IsProcessing}"
                     IsIndeterminate="True" Height="4" Margin="0,10,0,0"
                     Background="Transparent" Foreground="#3498db"/>

        <Grid Grid.Row="5" Grid.Column="0" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="13"
                       Foreground="#2ecc71" IsVisible="{Binding !HasErrors}"/>
            <TextBox Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="12"
                     Foreground="#e74c3c" Background="#3a1a1a" BorderBrush="#c0392b" BorderThickness="1"
                     IsReadOnly="True" IsVisible="{Binding HasErrors}"
                     Watermark="Errors will be shown here..."/>
        </Grid>

        <Border Grid.Row="0" Grid.RowSpan="6" Grid.Column="1" Margin="15,0,0,0"
                BorderBrush="#444" BorderThickness="1" CornerRadius="4" Background="#252526">
            <Grid Margin="10" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="✅ Selected for deletion"
                           FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto" IsTabStop="False">
                    <TreeView x:Name="SelectedFoldersTree"
                              ItemsSource="{Binding SelectedFoldersTree}"
                              Background="Transparent" BorderThickness="0"
                              IsHitTestVisible="False" MinHeight="200">
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="2,2">
                                    <TextBlock Text="✓" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{Binding IsChecked, Converter={x:Static converters:SimpleBoolConverter.Instance}, FallbackValue=Gray}"/>
                                    <TextBlock VerticalAlignment="Center" Foreground="White" FontSize="11" MaxWidth="250">
                                        <Run Text="{Binding DisplayPath}" Foreground="Gray" FontSize="9"/>
                                        <LineBreak/>
                                        <Run Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                    </TextBlock>
                                </StackPanel>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
            </Grid>
        </Border>

    </Grid>
</UserControl>